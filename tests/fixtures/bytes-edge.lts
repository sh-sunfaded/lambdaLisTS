;; bytes-edge.lts — design/interp-capability.md §1.4（C8 bytes）の差分テスト fixture。
;; bytes は不変バイト列。JS バックエンドでは Uint8Array。印字は #u8[1 2 3] 形式で両実装同一。
;; read-file!（§4.1）は Node fs 依存のため JS 差分テストからは除外（interp の仮想ファイルでのみテスト）。

;; --- 基本操作 ---
(example (bytes-len (str->bytes "abc")) => 3)
(example (bytes-len (str->bytes "😀")) => 4)
(example (bytes-len (str->bytes "")) => 0)
(example (bytes-get (str->bytes "abc") 0) => 97)
(example (bytes-get (str->bytes "abc") 1.9) => 98)
(example (bytes-get (str->bytes "abc") 5) => nil)
(example (bytes-get (str->bytes "abc") -1) => nil)
(example (= (bytes-slice (str->bytes "abcdef") 1 4) (str->bytes "bcd")) => true)
(example (bytes-len (bytes-slice (str->bytes "abcdef") -2 99)) => 2)
(example (bytes-len (bytes-slice (str->bytes "abcdef") 4 2)) => 0)

;; --- UTF-8 往復（マルチバイト・絵文字） ---
(example (= (bytes->str (str->bytes "a😀b")) (ok "a😀b")) => true)
(example (= (bytes->str (str->bytes "")) (ok "")) => true)
(example (= (bytes->str (str->bytes "こんにちは")) (ok "こんにちは")) => true)
;; 無効 UTF-8（絵文字の途中バイト）→ invalid-utf8
(example (= (bytes->str (bytes-slice (str->bytes "😀") 0 1)) (err (obj (tag "invalid-utf8")))) => true)
(example (= (bytes->str (bytes-slice (str->bytes "😀") 1 3)) (err (obj (tag "invalid-utf8")))) => true)
;; サロゲート領域のバイト列（0xED 0xA0 0x80 = U+D800 のUTF-8風）も invalid-utf8
(example (= (bytes->str (bytes-slice (str->bytes "\u3042") 0 1)) (err (obj (tag "invalid-utf8")))) => true)

;; --- codepoints（スカラー値。サロゲート領域は invalid-code） ---
(example (str->codepoints "a😀b") => (array 97 128512 98))
(example (str->codepoints "") => (array))
(example (= (codepoints->str (array 97 128512 98)) (ok "a😀b")) => true)
(example (= (codepoints->str (array 65535)) (ok "￿")) => true)
(example (= (codepoints->str (array 55296)) (err (obj (tag "invalid-code")))) => true)
(example (= (codepoints->str (array 57343)) (err (obj (tag "invalid-code")))) => true)
(example (= (codepoints->str (array 1114112)) (err (obj (tag "invalid-code")))) => true)
(example (= (codepoints->str (array 65.5)) (err (obj (tag "invalid-code")))) => true)
(example (= (codepoints->str (array -1)) (err (obj (tag "invalid-code")))) => true)

;; --- 印字（#u8[...] 形式。interp/JS 同一バイト列） ---
(example (str (str->bytes "AB")) => "#u8[65 66]")
(example (str (str->bytes "")) => "#u8[]")
(example (str (bytes-slice (str->bytes "😀") 0 1)) => "#u8[240]")

;; --- 等価 ---
(example (= (str->bytes "ab") (str->bytes "ab")) => true)
(example (= (str->bytes "ab") (str->bytes "ac")) => false)
